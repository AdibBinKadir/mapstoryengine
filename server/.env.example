# Copy to server/.env (gitignored) and fill in. Never commit real keys.

# 1 = canned replies, no models or keys needed (same as `python -m server --fake`)
FAKE=0

# Sphinx LLM (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# "gemini-flash-latest" always points at Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest
# Optional: set 0 to turn off "thinking" for lower latency (only on models that support thinkingBudget)
GEMINI_THINKING_BUDGET=

# Speech-to-text: Groq is tried first, OpenAI is the fallback. Either one alone is enough.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Sphinx voice: ElevenLabs text-to-speech (https://elevenlabs.io > Profile > API keys).
ELEVENLABS_API_KEY=
# The voice's ID, copied from its page in ElevenLabs (Voices > ... > Copy voice ID).
ELEVENLABS_VOICE_ID=
# Flash is the low-latency model; she has to answer within Unity's ~8 s wait.
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_TIMEOUT_S=3

# Unity waits ~8 s for /sphinx and /sphinx/talk, so the server answers within this budget.
REQUEST_BUDGET_S=7.5
STT_TIMEOUT_S=4
LLM_TIMEOUT_S=8

# Medusa gaze: looking = face found AND |yaw| < GAZE_YAW_MAX AND |pitch| < GAZE_PITCH_MAX,
# smoothed as a majority vote over the last GAZE_SMOOTH_FRAMES frames.
GAZE_YAW_MAX=20
GAZE_PITCH_MAX=20
GAZE_SMOOTH_FRAMES=3
